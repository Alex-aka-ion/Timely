# Скопируйте этот файл в .env и заполните значения.
# .env НИКОГДА не должен быть закоммичен в git.

# Telegram
BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEACHER_TELEGRAM_ID=123456789
# Необязательно: второй telegram_id с правами преподавателя — например,
# разработчика, который подключается параллельно, чтобы видеть все действия
# и уведомления и при необходимости сам ими управлять. Узнать свой
# telegram_id можно так же, как и для TEACHER_TELEGRAM_ID — через
# @userinfobot. Оставьте пустым, если не нужно.
DEV_TELEGRAM_ID=

# База данных
DB_PATH=./data/booking.db

# Google Calendar
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary

# Напоминания (через запятую). 24h,2h = за 24 часа и за 2 часа до занятия
REMINDER_INTERVALS=24h,2h
SCHEDULER_TICK=5m

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json

# Часовой пояс занятий — влияет на время в текстах напоминаний
# (formatEvent/formatWhen форматируют его через time.Local). Актуально
# только для деплоя через Docker (docker-compose.yml): у контейнера нет
# собственного часового пояса хоста, без TZ он был бы UTC. При деплое
# через systemd (deploy/booking-bot.service) эта переменная не нужна —
# time.Local там уже берётся из настроек самого сервера.
TZ=Asia/Yerevan
