# Скопируйте этот файл в .env и заполните значения.
# .env НИКОГДА не должен быть закоммичен в git.

# Telegram
BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEACHER_TELEGRAM_ID=123456789

# База данных
DB_PATH=./data/booking.db

# Google Calendar
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary

# Напоминания (через запятую). 24h,2h = за 24 часа и за 2 часа до занятия
REMINDER_INTERVALS=24h,2h
SCHEDULER_TICK=5m

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json
